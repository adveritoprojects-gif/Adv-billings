# PostgreSQL connection string (required)
# All tenant data lives in this database, isolated by organization_id columns.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_platform?schema=public"

# Direct connection string for Prisma migrations (optional but recommended
# when using PgBouncer / connection pooling in production).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/saas_platform?schema=public"

# Secret used to sign session cookies (HMAC-SHA256).
# MUST be at least 32 random characters; placeholder values are rejected at runtime.
# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-secret"

# Public URL of the deployed app (used for absolute links / metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail SMTP (nodemailer) — sends owner invitation emails.
# Use a Google App Password (Google Account → Security → 2-Step Verification →
# App passwords), never your normal account password. Leave blank to disable
# invitation email delivery (invitations are still created, marked unsent).
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_USER="your-address@gmail.com"
EMAIL_PASSWORD=""
EMAIL_FROM="Adverito Projects <your-address@gmail.com>"

# Absolute origin used to build invitation activation links.
# Falls back to NEXT_PUBLIC_APP_URL when unset.
# Local: http://localhost:3000 · Production: https://adv-billings.vercel.app
APP_URL="http://localhost:3000"
