# PostgreSQL connection string (required)
# All tenant data lives in this database, isolated by organization_id columns.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_platform?schema=public"

# Direct connection string for Prisma migrations (optional but recommended
# when using PgBouncer / connection pooling in production).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/saas_platform?schema=public"

# Secret used to sign session cookies (HMAC-SHA256).
# MUST be at least 32 random characters; placeholder values are rejected at runtime.
# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-secret"

# Public URL of the deployed app (used for absolute links / metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
