generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  SUPER_ADMIN
  OWNER
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PlanKey {
  FREE_TRIAL
  STARTER
  BUSINESS
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionState {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum SubscriptionEventType {
  CREATED
  PLAN_CHANGED
  STATE_CHANGED
  RENEWED
  CANCELLED
  LIMIT_REACHED
}

enum UsageMetric {
  USERS
  LEADS
  CUSTOMERS
  PROJECTS
  STORAGE
}

enum PlanInterval {
  MONTH
  YEAR
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum ActivityLevel {
  INFO
  WARNING
  ERROR
  AUDIT
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum CrmLeadSource {
  WEB_FORM
  REFERRAL
  IMPORT
  COLD_CALL
  SOCIAL
  ADS
  EVENT
  OTHER
}

enum CrmPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CrmTaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELED
}

enum CrmCustomerStatus {
  ACTIVE
  INACTIVE
  CHURNED
}

enum CrmFollowUpType {
  CALL
  EMAIL
  MEETING
  OTHER
}

enum CrmFollowUpStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELED
}

enum CrmActivityType {
  CREATED
  STATUS_CHANGE
  ASSIGNMENT
  NOTE
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
  TASK
  SYSTEM
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships OrganizationMember[]
  sessions    Session[]
  invitations Invitation[]
  activities  ActivityLog[]        @relation("ActivityActor")

  platformAuditLogs PlatformAuditLog[] @relation("PlatformAuditActor")

  assignedLeads     CrmLead[]     @relation("CrmLeadAssignee")
  assignedContacts  CrmContact[]  @relation("CrmContactAssignee")
  assignedCustomers CrmCustomer[] @relation("CrmCustomerAssignee")
  assignedTasks     CrmTask[]     @relation("CrmTaskAssignee")
  assignedFollowUps CrmFollowUp[] @relation("CrmFollowUpAssignee")
  crmActivities     CrmActivity[] @relation("CrmActivityActor")
  crmNotes          CrmNote[]     @relation("CrmNoteAuthor")

  @@index([status])
  @@index([createdAt])
}

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  organizationId String?
  expiresAt      DateTime
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
}

model Invitation {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  organizationId String
  email          String
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
}

model Organization {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  logo            String?
  favicon         String?
  loginLogo       String?
  loginBackground String?
  primaryColor    String?            @default("#465fff")
  secondaryColor  String?
  businessType    String?
  email           String?
  phone           String?
  website         String?
  address         String?
  timezone        String?            @default("UTC")
  currency        String?            @default("USD")
  dateFormat      String?            @default("yyyy-MM-dd")
  status          OrganizationStatus @default(ACTIVE)
  isPlatform      Boolean            @default(false)
  templateKey     String             @default("general")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  members      OrganizationMember[]
  roles        Role[]
  sessions     Session[]
  invitations  Invitation[]
  subscription Subscription?
  modules      OrganizationModule[]
  settings     Setting[]
  activityLogs ActivityLog[]

  subscriptionEvents SubscriptionEvent[]
  usage              Usage[]

  platformAuditLogs PlatformAuditLog[]

  crmLeads      CrmLead[]
  crmContacts   CrmContact[]
  crmCompanies  CrmCompany[]
  crmCustomers  CrmCustomer[]
  crmActivities CrmActivity[]
  crmTasks      CrmTask[]
  crmNotes      CrmNote[]
  crmFollowUps  CrmFollowUp[]

  @@index([status])
  @@index([businessType])
  @@index([createdAt])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@index([roleId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members         OrganizationMember[]
  rolePermissions RolePermission[]

  @@unique([organizationId, key])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  group       String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([group])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Plan {
  id          String       @id @default(cuid())
  key         PlanKey      @unique
  name        String
  description String?
  priceCents  Int          @default(0)
  currency    String       @default("USD")
  interval    PlanInterval @default(MONTH)
  trialDays   Int          @default(0)
  limits      Json
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
}

model Subscription {
  id                     String            @id @default(cuid())
  organizationId         String            @unique
  planId                 String
  state                  SubscriptionState @default(TRIAL)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean           @default(false)
  endedAt                DateTime?
  externalCustomerId     String?           @unique
  externalSubscriptionId String?           @unique
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  events       SubscriptionEvent[]
  usage        Usage[]

  @@index([state])
  @@index([planId])
  @@index([currentPeriodEnd])
}

model SubscriptionEvent {
  id             String                @id @default(cuid())
  organizationId String
  subscriptionId String?
  type           SubscriptionEventType
  fromState      SubscriptionState?
  toState        SubscriptionState?
  planKey        PlanKey?
  metadata       Json?
  actorId        String?
  createdAt      DateTime              @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([subscriptionId])
}

model Usage {
  id             String      @id @default(cuid())
  organizationId String
  subscriptionId String?
  metric         UsageMetric
  quantity       BigInt      @default(0)
  periodStart    DateTime
  periodEnd      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId, metric])
}

model Module {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  icon        String?
  isCore      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationModules OrganizationModule[]

  @@index([isCore, sortOrder])
}

model OrganizationModule {
  id             String    @id @default(cuid())
  organizationId String
  moduleId       String
  enabled        Boolean   @default(true)
  settings       Json?
  enabledAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId])
  @@index([organizationId, enabled])
}

model Setting {
  id             String      @id @default(cuid())
  organizationId String
  key            String
  value          Json
  type           SettingType @default(JSON)
  group          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, group])
}

model ActivityLog {
  id             String        @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entity         String?
  entityId       String?
  level          ActivityLevel @default(INFO)
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action])
  @@index([actorId])
}

model PlatformAuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  organizationId String?
  action         String
  summary        String
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  actor        User?         @relation("PlatformAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([organizationId])
  @@index([action])
}

model CrmLead {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  company        String?
  source         CrmLeadSource @default(OTHER)
  status         CrmLeadStatus @default(NEW)
  priority       CrmPriority   @default(MEDIUM)
  assignedToId   String?
  notes          String?
  valueCents     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo    User?        @relation("CrmLeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities    CrmActivity[]
  tasks         CrmTask[]
  crmNotes      CrmNote[]
  followUps     CrmFollowUp[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, assignedToId])
  @@index([organizationId, company])
}

model CrmContact {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  jobTitle       String?
  companyId      String?
  assignedToId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      CrmCompany?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo   User?         @relation("CrmContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities   CrmActivity[]
  notes        CrmNote[]
  followUps    CrmFollowUp[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, companyId])
  @@index([organizationId, assignedToId])
}

model CrmCompany {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  website        String?
  industry       String?
  email          String?
  phone          String?
  address        String?
  size           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     CrmContact[]
  activities   CrmActivity[]
  notes        CrmNote[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, name])
}

model CrmCustomer {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  company        String?
  status         CrmCustomerStatus @default(ACTIVE)
  assignedToId   String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?         @relation("CrmCustomerAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities   CrmActivity[]
  crmNotes     CrmNote[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, assignedToId])
}

model CrmActivity {
  id             String          @id @default(cuid())
  organizationId String
  type           CrmActivityType
  subject        String
  description    String?
  actorId        String?
  leadId         String?
  contactId      String?
  customerId     String?
  companyId      String?
  taskId         String?
  occurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?       @relation("CrmActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  lead         CrmLead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      CrmContact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  customer     CrmCustomer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company      CrmCompany?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task         CrmTask?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, leadId])
  @@index([organizationId, type])
}

model CrmTask {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         CrmTaskStatus @default(OPEN)
  priority       CrmPriority   @default(MEDIUM)
  dueAt          DateTime?
  assignedToId   String?
  leadId         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?         @relation("CrmTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lead         CrmLead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities   CrmActivity[]
  notes        CrmNote[]

  @@index([organizationId, status])
  @@index([organizationId, dueAt])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, assignedToId])
}

model CrmNote {
  id             String   @id @default(cuid())
  organizationId String
  body           String
  authorId       String?
  leadId         String?
  contactId      String?
  customerId     String?
  companyId      String?
  taskId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?       @relation("CrmNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lead         CrmLead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      CrmContact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  customer     CrmCustomer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company      CrmCompany?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task         CrmTask?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, leadId])
}

model CrmFollowUp {
  id             String            @id @default(cuid())
  organizationId String
  type           CrmFollowUpType   @default(CALL)
  dueAt          DateTime
  notes          String?
  status         CrmFollowUpStatus @default(SCHEDULED)
  assignedToId   String?
  leadId         String?
  contactId      String?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?       @relation("CrmFollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lead         CrmLead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      CrmContact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId, dueAt])
  @@index([organizationId, status])
  @@index([organizationId, leadId])
}
